# Custom Exclusions
*.csv
*.pt

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environments
.venv
venv/
ENV/
env/
# Poetry/Pipenv files
.venv/
bin/
lib/
develop-eggs/
dist/
downloads/
eggs/
